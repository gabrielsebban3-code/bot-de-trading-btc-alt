# --------------------------------------------------------------------------- #
# Copy this file to ".env" and fill in your values.
#   cp .env.example .env
# --------------------------------------------------------------------------- #

# Discord webhook that receives the signal alerts (required).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY

# Binance API credentials (OPTIONAL, read-only key recommended).
# Public market data works without keys, but supplying a key raises rate limits.
BINANCE_API_KEY=
BINANCE_API_SECRET=
