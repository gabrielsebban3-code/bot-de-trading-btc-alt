# Copie ce fichier en ".env" et remplis les valeurs.
# NE JAMAIS committer le vrai .env (il est ignoré par .gitignore).

# Webhook Discord où les alertes seront envoyées (obligatoire)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy

# Clé API Binance en LECTURE SEULE (optionnelle : les données OHLCV publiques
# ne nécessitent pas de clé). Renseigne-la seulement si tu veux des limites
# de requêtes plus élevées.
BINANCE_API_KEY=
BINANCE_API_SECRET=
