# Copie ce fichier en ".env" et remplis les valeurs.
# Sur Railway : mets ces variables dans Settings > Variables (PAS de fichier .env).

# --- OBLIGATOIRE ---
# URL de ton webhook Discord (Salon > Paramètres > Intégrations > Webhooks).
DISCORD_WEBHOOK_URL=

# --- OPTIONNEL ---
# Envoyer un message Discord au démarrage du bot (true/false).
SEND_STARTUP_MESSAGE=true

# Lancer un scan immédiat au démarrage sans attendre la clôture 15m (true/false).
# Pratique pour tester. Mettre "false" en production.
RUN_ON_START=false

# Si Binance est bloqué dans ta région, change l'URL de base.
# BINANCE_BASE_URL=https://api.binance.com
