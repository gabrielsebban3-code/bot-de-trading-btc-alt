# ─── Discord ──────────────────────────────────────────────────────────────────
# URL du webhook Discord (obligatoire pour les alertes)
# Créer via : Paramètres du serveur → Intégrations → Webhooks → Nouveau webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/VOTRE_ID/VOTRE_TOKEN

# ─── Paires à surveiller ──────────────────────────────────────────────────────
# Liste séparée par virgules (format ccxt : BASE/QUOTE)
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,ADA/USDT,DOGE/USDT,AVAX/USDT,LINK/USDT,DOT/USDT

# ─── Paramètres du bot live ───────────────────────────────────────────────────
# Intervalle entre chaque scan complet (secondes)
SCAN_INTERVAL_SECONDS=15
# Délai minimum entre deux signaux pour la même paire/direction (minutes)
COOLDOWN_MINUTES=15

# ─── Paramètres de la stratégie ───────────────────────────────────────────────
# R:R minimum pour émettre un signal (1.5 = TP2 doit valoir au moins 1.5× le risque)
RISK_REWARD_MIN=1.5
# Multiplicateur ATR pour le stop-loss (SL = entry ± ATR × multiplicateur)
ATR_MULTIPLIER=1.5
# ATR en % du close : en-dessous de ce seuil, le marché est trop calme (skip)
MIN_ATR_PERCENT=0.05
# Fenêtre RSI lookback (en bougies 1m) pour détecter le retournement
RSI_LOOKBACK=5
# Seuils RSI pour les déclencheurs
RSI_OVERSOLD=45
RSI_OVERBOUGHT=55
# Volume minimum : N× le volume moyen pour confirmer l'impulsion
VOLUME_MULTIPLIER=1.2
# Proximité du pullback vers EMA21/VWAP (% du close)
PULLBACK_PROXIMITY_PCT=0.15

# ─── Backtest ─────────────────────────────────────────────────────────────────
# Frais taker Binance Futures (par côté, en %)
FEE_PERCENT=0.04
# Slippage estimé (par côté, en %)
SLIPPAGE_PERCENT=0.02
